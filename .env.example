# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# On Colab, put the same file where src/sartransfer/env.py looks for it (SEARCH_PATHS), because
# the Colab server cannot see your local disk. Use short-lived, least-privilege tokens, and keep
# this file private.

# huggingface.co -> Settings -> Access Tokens. A read token is enough for the
# gated model weights (DINOv3, C-RADIOv4) and for reading your private converted-data
# repos back. Notebooks 02 and 03 load only this key; if it cannot read those repos,
# they copy the data from Drive instead.
HF_TOKEN=

# huggingface.co -> Settings -> Access Tokens. A write token, only for uploading
# the CONVERTED datasets to your private repos <account>/sar-transfer-<dataset> (with '-' for '_':
# glacial-lakes, snow, forty-v1, glavitu-alp; the account is DATASET_HF_OWNER below).
# Read only by notebook 01's upload cell (env.secret), never put into the environment.
HF_WRITE_TOKEN=

# Your Hugging Face account that holds the private copies of the converted datasets.
# Notebook 01 uploads to it; notebooks 02 and 03 read from it, or use the Drive copy when empty.
DATASET_HF_OWNER=
